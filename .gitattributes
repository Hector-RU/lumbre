# Normalize line endings: LF in the repository, platform specific on checkout.
* text=auto

# Scripts must keep their own line endings.
*.bat text eol=crlf
*.ps1 text eol=crlf
gradlew text eol=lf

# Binary assets.
*.png binary
*.webp binary
*.epub binary
*.jar binary
*.jks binary
*.keystore binary
*.hprof binary
